<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CalculatorlLayout" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/operator_btn_bg</item>
        <item name="colorSecondary">@color/change_btn_bg</item>
        <item name="android:statusBarColor">@color/display_bg</item>
    </style>

    <style name="Theme.CalculatorlLayout" parent="Base.Theme.CalculatorlLayout" />

    <style name="CalcButtonStyle" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_margin">1.5dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NumberButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_number</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="OperatorButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_operator</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="OperatorLeftButtonStyle" parent="OperatorButtonStyle" />

    <style name="FunctionButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_function</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SpecialButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_special</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MemoryButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_memory</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="MinusButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_minus</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="ChangeButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_change</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="LargePlusButtonStyle" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_arithmetic</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="SwitchContainerStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SwitchLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">8sp</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
