<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/calc_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/calculatorBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- 1. TOP DISPLAY -->
        <FrameLayout
            android:id="@+id/displayLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/display_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/displayText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="monospace"
                android:gravity="end|center_vertical"
                android:maxLines="1"
                android:text="@string/digit_0"
                android:textColor="@color/display_digit"
                android:textSize="36sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- 2. BRAND & PHYSICAL CONTROLS AREA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="8dp">

            <!-- Branding + CHANGE Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sharp_model_text"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnChange"
                    style="@style/ChangeButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:text="@string/change_text"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Spacer 1 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Switch 1: Decimal (F 6 3 2 1 0 A) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/decimal_labels"
                    android:textColor="#333333"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    tools:ignore="SmallSp" />

                <FrameLayout
                    android:id="@+id/decimalSwitch"
                    android:layout_width="66dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_gravity="center_vertical"
                        android:background="#4A4A4A" />

                    <View
                        android:id="@+id/decimalKnob"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/slider_knob" />
                </FrameLayout>
            </LinearLayout>

            <!-- Spacer 2 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Switch 2: GT Set (GT · SET) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gt_set_text"
                    android:textColor="#333333"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    tools:ignore="SmallSp" />

                <FrameLayout
                    android:id="@+id/gtRateSwitch"
                    android:layout_width="26dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="9dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/switch_capsule_track" />

                    <View
                        android:id="@+id/gtRateKnob"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center_vertical|start"
                        android:background="@drawable/slider_knob" />
                </FrameLayout>
            </LinearLayout>

            <!-- Spacer 3 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Switch 3: Rounding (↑ 5/4 ↓) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/round_labels"
                    android:textColor="#333333"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    tools:ignore="SmallSp" />

                <FrameLayout
                    android:id="@+id/roundSwitch"
                    android:layout_width="32dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_gravity="center_vertical"
                        android:background="#4A4A4A" />

                    <View
                        android:id="@+id/roundKnob"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/slider_knob" />
                </FrameLayout>
            </LinearLayout>

            <!-- Spacer 4 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Switch 4: Mode (OFF P P•IC ON) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mode_labels"
                    android:textColor="#333333"
                    android:textSize="7.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    tools:ignore="SmallSp" />

                <FrameLayout
                    android:id="@+id/modeSwitch"
                    android:layout_width="68dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="2dp"
                    android:clickable="true"
                    android:focusable="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1.5dp"
                        android:layout_gravity="center_vertical"
                        android:background="#4A4A4A" />

                    <View
                        android:id="@+id/modeKnob"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:layout_gravity="center_vertical|end"
                        android:background="@drawable/slider_knob" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 3. TOP FUNCTION BUTTON ROW -->
        <LinearLayout
            android:id="@+id/functionButtonsLayout"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:orientation="horizontal"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="10dp">

            <!-- GROUP 1: Backspace (Aligns with Col 1) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack"
                style="@style/FunctionButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="13"
                android:text="@string/backspace_text" />

            <!-- Section Gap 1 (~10dp) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5" />

            <!-- GROUP 2: COST, SELL, MGN (Aligns with Cols 2, 3, 4) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCost"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1.5dp"
                    android:text="@string/cost_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSell"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1.5dp"
                    android:text="@string/sell_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnMgn"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/mgn_text" />
            </LinearLayout>

            <!-- Section Gap 2 (~10dp) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5" />

            <!-- GROUP 3: +/-, AVG, GT (Aligns with Cols 5 & 6) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="26"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnPlusMinus"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1.5dp"
                    android:text="@string/plus_minus_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAvg"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1.5dp"
                    android:text="@string/avg_text" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnGT"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/gt_text" />
            </LinearLayout>

            <!-- Section Gap 3 (~10dp) -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5" />

            <!-- GROUP 4: TAX+, TAX- (Aligns with Col 7) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="13.5"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTaxPlus"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1.5dp"
                    android:text="@string/tax_plus" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTaxMinus"
                    style="@style/FunctionButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="@string/tax_minus" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. MAIN KEYPAD (7 COLUMNS x 4 ROWS IN CONSTRAINTLAYOUT) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/keypadLayout"
            android:layout_width="match_parent"
            android:layout_height="350dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp">

            <!-- SECTION 1 (Col 1: ÷, =, ×, C/CE) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.0" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.13" />

            <!-- SECTION GAP 1 -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v1_gap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.155" />

            <!-- SECTION 2 (Cols 2, 3, 4: Numeric Grid) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.288" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.421" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.555" />

            <!-- SECTION GAP 2 -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v4_gap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.580" />

            <!-- SECTION 3 (Cols 5 & 6: Arithmetic & Special) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.710" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.840" />

            <!-- SECTION GAP 3 -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v6_gap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.865" />

            <!-- SECTION 4 (Col 7: Memory) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_v7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="1.0" />

            <!-- Horizontal Guidelines (4 Rows) -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_h0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.0" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_h1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.25" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_h2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.50" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_h3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.75" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_h4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="1.0" />

            <!-- COLUMN 1: ÷, =, ×, C/CE -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDivide"
                style="@style/OperatorButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/op_divide"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v0"
                app:layout_constraintEnd_toEndOf="@id/gl_v1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEquals"
                style="@style/OperatorButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/op_equals"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h2"
                app:layout_constraintStart_toStartOf="@id/gl_v0"
                app:layout_constraintEnd_toEndOf="@id/gl_v1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMultiply"
                style="@style/OperatorButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/op_multiply"
                app:layout_constraintTop_toTopOf="@id/gl_h2"
                app:layout_constraintBottom_toBottomOf="@id/gl_h3"
                app:layout_constraintStart_toStartOf="@id/gl_v0"
                app:layout_constraintEnd_toEndOf="@id/gl_v1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCE"
                style="@style/OperatorButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/ce_text"
                android:textSize="11sp"
                app:layout_constraintTop_toTopOf="@id/gl_h3"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v0"
                app:layout_constraintEnd_toEndOf="@id/gl_v1" />

            <!-- COLUMN 2: 7, 4, 1, 0 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn7"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_7"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v1_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v2" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn4"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_4"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h2"
                app:layout_constraintStart_toStartOf="@id/gl_v1_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v2" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn1"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_1"
                app:layout_constraintTop_toTopOf="@id/gl_h2"
                app:layout_constraintBottom_toBottomOf="@id/gl_h3"
                app:layout_constraintStart_toStartOf="@id/gl_v1_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v2" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_0"
                app:layout_constraintTop_toTopOf="@id/gl_h3"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v1_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v2" />

            <!-- COLUMN 3: 8, 5, 2, 00 -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn8"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_8"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v2"
                app:layout_constraintEnd_toEndOf="@id/gl_v3" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn5"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_5"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h2"
                app:layout_constraintStart_toStartOf="@id/gl_v2"
                app:layout_constraintEnd_toEndOf="@id/gl_v3" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn2"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_2"
                app:layout_constraintTop_toTopOf="@id/gl_h2"
                app:layout_constraintBottom_toBottomOf="@id/gl_h3"
                app:layout_constraintStart_toStartOf="@id/gl_v2"
                app:layout_constraintEnd_toEndOf="@id/gl_v3" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn00"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_00"
                app:layout_constraintTop_toTopOf="@id/gl_h3"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v2"
                app:layout_constraintEnd_toEndOf="@id/gl_v3" />

            <!-- COLUMN 4: 9, 6, 3, . -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn9"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_9"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v3"
                app:layout_constraintEnd_toEndOf="@id/gl_v4" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn6"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_6"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h2"
                app:layout_constraintStart_toStartOf="@id/gl_v3"
                app:layout_constraintEnd_toEndOf="@id/gl_v4" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn3"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/digit_3"
                app:layout_constraintTop_toTopOf="@id/gl_h2"
                app:layout_constraintBottom_toBottomOf="@id/gl_h3"
                app:layout_constraintStart_toStartOf="@id/gl_v3"
                app:layout_constraintEnd_toEndOf="@id/gl_v4" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDot"
                style="@style/NumberButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/op_dot"
                app:layout_constraintTop_toTopOf="@id/gl_h3"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v3"
                app:layout_constraintEnd_toEndOf="@id/gl_v4" />

            <!-- COLUMN 5: - (row 1), + (spans rows 2..4) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMinus"
                style="@style/MinusButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/op_minus"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v4_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v5" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlus"
                style="@style/LargePlusButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/op_plus"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v4_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v5" />

            <!-- COLUMN 6: % (row 1), #/◇ (row 2), * (spans rows 3..4) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPercent"
                style="@style/SpecialButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/percent_text"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v5"
                app:layout_constraintEnd_toEndOf="@id/gl_v6" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnHashDiamond"
                style="@style/SpecialButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/hash_diamond_text"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h2"
                app:layout_constraintStart_toStartOf="@id/gl_v5"
                app:layout_constraintEnd_toEndOf="@id/gl_v6" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnStar"
                style="@style/SpecialButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/star_text"
                android:textSize="22sp"
                app:layout_constraintTop_toTopOf="@id/gl_h2"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v5"
                app:layout_constraintEnd_toEndOf="@id/gl_v6" />

            <!-- COLUMN 7: *M, ◇M, M-, M+ -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMStar"
                style="@style/MemoryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/memory_star_text"
                app:layout_constraintTop_toTopOf="@id/gl_h0"
                app:layout_constraintBottom_toBottomOf="@id/gl_h1"
                app:layout_constraintStart_toStartOf="@id/gl_v6_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v7" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMDiamond"
                style="@style/MemoryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/memory_diamond_text"
                app:layout_constraintTop_toTopOf="@id/gl_h1"
                app:layout_constraintBottom_toBottomOf="@id/gl_h2"
                app:layout_constraintStart_toStartOf="@id/gl_v6_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v7" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMMinus"
                style="@style/MemoryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/memory_minus_text"
                app:layout_constraintTop_toTopOf="@id/gl_h2"
                app:layout_constraintBottom_toBottomOf="@id/gl_h3"
                app:layout_constraintStart_toStartOf="@id/gl_v6_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v7" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMPlus"
                style="@style/MemoryButtonStyle"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/memory_plus_text"
                app:layout_constraintTop_toTopOf="@id/gl_h3"
                app:layout_constraintBottom_toBottomOf="@id/gl_h4"
                app:layout_constraintStart_toStartOf="@id/gl_v6_gap"
                app:layout_constraintEnd_toEndOf="@id/gl_v7" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</ScrollView>
